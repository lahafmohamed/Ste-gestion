# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ste_gestion?schema=public"
PORT=3001

# Environnement : "production" active les contrôles durcis (secret fort obligatoire, CORS strict)
NODE_ENV="development"

# Secret JWT (obligatoire). En production : ≥32 caractères, généré aléatoirement.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"

# CORS : origines autorisées, séparées par des virgules (ex "https://ste.example.com").
# Vide = dev tout permis / production refuse le cross-origin. "*" = tout permis (déconseillé en prod).
CORS_ORIGIN=""

# Admin initial (créé au premier démarrage si aucun utilisateur). Changer le mot de passe.
ADMIN_EMAIL="admin@local"
ADMIN_PASSWORD="admin123"
